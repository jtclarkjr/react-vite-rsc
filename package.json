{
  "name": "react-vite-rsc",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "storybook": "vp exec storybook dev -p 6006",
    "storybook:ci": "vp exec storybook dev -p 6006 --ci --no-open",
    "build-storybook": "vp exec storybook build --output-dir /tmp/react-vite-rsc-storybook-static",
    "test:storybook": "vp test run --config vitest.storybook.config.ts --project storybook",
    "prepare": "vp config",
    "graphify:root": "node scripts/graphify-root.mjs",
    "graphify:setup": "vp run graphify:root",
    "graphify:update": "vp run graphify:root && graphify update . --force && graphify export callflow-html && vp run graphify:root"
  },
  "dependencies": {
    "@nanostores/react": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nanostores": "^1.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rsc-html-stream": "^0.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.27",
    "@vitest/browser-playwright": "^4.1.10",
    "happy-dom": "^20.10.6",
    "nitro": "3.0.260429-beta",
    "playwright": "^1.61.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.24",
    "vite-plus": "^0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "postcss": "8.5.10"
  },
  "packageManager": "bun@1.3.12"
}
