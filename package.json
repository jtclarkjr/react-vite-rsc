{
  "name": "react-vite-rsc",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "typegen": "vp exec void prepare",
    "test:e2e": "vp exec playwright test",
    "storybook": "vp exec storybook dev -p 6006",
    "storybook:ci": "vp exec storybook dev -p 6006 --ci --no-open",
    "build-storybook": "vp exec storybook build --output-dir /tmp/react-vite-rsc-storybook-static",
    "test:storybook": "vp test run --config vitest.storybook.config.ts --project storybook",
    "prepare": "vp config",
    "graphify:root": "node scripts/graphify-root.mjs",
    "graphify:setup": "vp run graphify:root",
    "graphify:update": "vp run graphify:root && graphify update . --force && graphify export callflow-html && vp run graphify:root"
  },
  "dependencies": {
    "@nanostores/react": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nanostores": "^1.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rsc-html-stream": "^0.0.7",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "@vitest/browser-playwright": "5.0.5",
    "happy-dom": "^20.14.6",
    "playwright": "^1.64.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "void": "1.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "void@1.1.11": "patches/void@1.1.11.patch"
  }
}
